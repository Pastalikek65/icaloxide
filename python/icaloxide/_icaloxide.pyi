import datetime
import os
from typing import Any, Dict, Iterator, List, Optional, Sequence, Tuple, Union

InputData = Union[bytes, bytearray, memoryview, str, os.PathLike[str]]
DateLike = Union[datetime.date, datetime.datetime]

__version__: str

class Component:
    @property
    def name(self) -> str: ...
    @property
    def uid(self) -> Optional[str]: ...
    @property
    def summary(self) -> Optional[str]: ...
    @property
    def description(self) -> Optional[str]: ...
    @property
    def location(self) -> Optional[str]: ...
    @property
    def status(self) -> Optional[str]: ...
    @property
    def subcomponents(self) -> List[Component]: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def get_all(self, key: str) -> List[Any]: ...
    def params(self, key: str) -> Dict[str, List[str]]: ...
    def raw_properties(self) -> List[Tuple[str, Any, Dict[str, List[str]]]]: ...
    def get_all_with_params(self, key: str) -> List[Tuple[Any, Dict[str, List[str]]]]: ...
    def property_names(self) -> List[str]: ...
    def to_ical(self) -> bytes: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...
    def __repr__(self) -> str: ...

class Occurrence:
    @property
    def start(self) -> DateLike: ...
    @property
    def end(self) -> DateLike: ...
    @property
    def is_all_day(self) -> bool: ...
    @property
    def name(self) -> str: ...
    @property
    def uid(self) -> Optional[str]: ...
    @property
    def summary(self) -> Optional[str]: ...
    @property
    def description(self) -> Optional[str]: ...
    @property
    def location(self) -> Optional[str]: ...
    @property
    def status(self) -> Optional[str]: ...
    @property
    def component(self) -> Component: ...
    def params(self, key: str) -> Dict[str, List[str]]: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def to_ical(self, *, keep_recurrence_attributes: bool = False) -> bytes: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...
    def __repr__(self) -> str: ...

class OccurrenceIterator(Iterator[Occurrence]):
    def __iter__(self) -> OccurrenceIterator: ...
    def __next__(self) -> Occurrence: ...

class OccurrencePageIterator(Iterator[List[Occurrence]]):
    def __iter__(self) -> OccurrencePageIterator: ...
    def __next__(self) -> List[Occurrence]: ...

def parse_component(data: InputData, *, strict: bool = False) -> Component: ...
def vtimezone_for_tzid(
    tzid: str, start_year: int = 1970, end_year: int = 2038
) -> Optional[bytes]: ...
def compile_vtimezone_transitions(
    data: InputData,
) -> List[Tuple[int, int, int, bool, Optional[str]]]: ...

class CalendarQuery:
    @property
    def suppressed_errors(self) -> List[str]: ...
    def at(self, date_or_dt: DateLike) -> List[Occurrence]: ...
    def between(self, start: DateLike, end: DateLike) -> List[Occurrence]: ...
    def after(
        self, dt: Optional[DateLike] = None, *, limit: Optional[int] = None
    ) -> OccurrenceIterator: ...
    def paginate(
        self,
        page_size: int,
        earliest_end: Optional[DateLike] = None,
        latest_start: Optional[DateLike] = None,
    ) -> OccurrencePageIterator: ...
    def first(self) -> Optional[Occurrence]: ...
    def next_after(self, dt: DateLike) -> Optional[Occurrence]: ...
    def all(self) -> List[Occurrence]: ...
    def count(self, start: DateLike, end: DateLike) -> int: ...
    def count_all(self) -> int: ...
    def busy_intervals(
        self, start: DateLike, end: DateLike
    ) -> List[Tuple[datetime.datetime, datetime.datetime]]: ...
    def free_intervals(
        self, start: DateLike, end: DateLike
    ) -> List[Tuple[datetime.datetime, datetime.datetime]]: ...

class Calendar:
    @classmethod
    def from_ical(cls, data: InputData, *, strict: bool = False) -> Calendar: ...
    @classmethod
    def parse_component(cls, data: InputData, *, strict: bool = False) -> Component: ...
    @classmethod
    def from_ical_multiple(
        cls, data: InputData, *, strict: bool = False
    ) -> List[Calendar]: ...
    @classmethod
    def new(
        cls,
        *,
        prodid: Optional[str] = None,
        name: Optional[str] = None,
    ) -> Calendar: ...
    def query(
        self,
        *,
        components: Optional[Sequence[str]] = None,
        skip_cancelled: bool = False,
        skip_bad_series: bool = False,
        default_tz: Optional[str] = None,
        max_iterations: Optional[int] = None,
        max_periods: Optional[int] = None,
    ) -> CalendarQuery: ...
    def add_missing_timezones(self) -> Calendar: ...
    def used_tzids(self) -> List[str]: ...
    def missing_tzids(self) -> List[str]: ...
    def validate(self) -> List[Tuple[int, str]]: ...
    def with_uid(self, uid: str) -> List[Component]: ...
    def resolve_utc_offset(
        self, tzid: str, dt: datetime.datetime
    ) -> Optional[datetime.timedelta]: ...
    def to_ical(self) -> bytes: ...
    @property
    def name(self) -> Optional[str]: ...
    @property
    def prodid(self) -> Optional[str]: ...
    @property
    def default_timezone(self) -> Optional[str]: ...
    @property
    def component_count(self) -> int: ...
    @property
    def warnings(self) -> List[Tuple[int, str]]: ...
    @property
    def root(self) -> Component: ...
    @property
    def events(self) -> List[Component]: ...
    @property
    def todos(self) -> List[Component]: ...
    @property
    def journals(self) -> List[Component]: ...
    @property
    def timezones(self) -> List[Component]: ...
    @property
    def freebusies(self) -> List[Component]: ...
    @property
    def availabilities(self) -> List[Component]: ...
    @property
    def subcomponents(self) -> List[Component]: ...
    def component_stats(self) -> Dict[str, int]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

class CalendarBuilder:
    def __init__(
        self, *, prodid: Optional[str] = None, name: Optional[str] = None
    ) -> None: ...
    def set_property(self, name: str, value: str) -> None: ...
    def add_event(
        self,
        *,
        uid: str,
        summary: str,
        start: DateLike,
        end: Optional[DateLike] = None,
        duration: Optional[datetime.timedelta] = None,
        rrule: Optional[str] = None,
        tzid: Optional[str] = None,
        location: Optional[str] = None,
        description: Optional[str] = None,
        categories: Optional[List[str]] = None,
    ) -> None: ...
    def add_todo(
        self,
        *,
        uid: str,
        summary: str,
        start: Optional[DateLike] = None,
        due: Optional[DateLike] = None,
        tzid: Optional[str] = None,
        status: Optional[str] = None,
    ) -> None: ...
    def add_journal(
        self,
        *,
        uid: str,
        summary: str,
        start: Optional[DateLike] = None,
        tzid: Optional[str] = None,
        description: Optional[str] = None,
    ) -> None: ...
    def add_alarm(
        self,
        *,
        trigger: Union[datetime.timedelta, DateLike],
        action: str = "DISPLAY",
        description: Optional[str] = None,
        summary: Optional[str] = None,
        duration: Optional[datetime.timedelta] = None,
        repeat: Optional[int] = None,
        parent_uid: Optional[str] = None,
    ) -> None: ...
    def build(self) -> Calendar: ...
    def to_ical(self) -> bytes: ...
