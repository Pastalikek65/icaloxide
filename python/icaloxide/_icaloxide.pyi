import datetime
import os
from typing import Any, Dict, Iterator, List, Optional, Sequence, Tuple, Union

InputData = Union[bytes, bytearray, memoryview, str, os.PathLike[str]]
DateLike = Union[datetime.date, datetime.datetime]

__version__: str

class Component:
    @property
    def name(self) -> str: ...
    @property
    def uid(self) -> Optional[str]: ...
    @property
    def summary(self) -> Optional[str]: ...
    @property
    def description(self) -> Optional[str]: ...
    @property
    def location(self) -> Optional[str]: ...
    @property
    def status(self) -> Optional[str]: ...
    @property
    def subcomponents(self) -> List[Component]: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def get_all(self, key: str) -> List[Any]: ...
    def params(self, key: str) -> Dict[str, List[str]]: ...
    def property_names(self) -> List[str]: ...
    def to_ical(self) -> bytes: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...
    def __repr__(self) -> str: ...

class Occurrence:
    @property
    def start(self) -> DateLike: ...
    @property
    def end(self) -> DateLike: ...
    @property
    def is_all_day(self) -> bool: ...
    @property
    def name(self) -> str: ...
    @property
    def uid(self) -> Optional[str]: ...
    @property
    def summary(self) -> Optional[str]: ...
    @property
    def description(self) -> Optional[str]: ...
    @property
    def location(self) -> Optional[str]: ...
    @property
    def status(self) -> Optional[str]: ...
    @property
    def component(self) -> Component: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def to_ical(self) -> bytes: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...
    def __repr__(self) -> str: ...

class OccurrenceIterator(Iterator[Occurrence]):
    def __iter__(self) -> OccurrenceIterator: ...
    def __next__(self) -> Occurrence: ...

class CalendarQuery:
    def at(self, date_or_dt: DateLike) -> List[Occurrence]: ...
    def between(self, start: DateLike, end: DateLike) -> List[Occurrence]: ...
    def after(
        self, dt: DateLike, *, limit: Optional[int] = None
    ) -> OccurrenceIterator: ...
    def count(self, start: DateLike, end: DateLike) -> int: ...

class Calendar:
    @classmethod
    def from_ical(cls, data: InputData, *, strict: bool = False) -> Calendar: ...
    @classmethod
    def from_ical_multiple(
        cls, data: InputData, *, strict: bool = False
    ) -> List[Calendar]: ...
    @classmethod
    def new(
        cls,
        *,
        prodid: Optional[str] = None,
        name: Optional[str] = None,
    ) -> Calendar: ...
    def query(
        self,
        *,
        components: Optional[Sequence[str]] = None,
        skip_cancelled: bool = False,
    ) -> CalendarQuery: ...
    def add_missing_timezones(self) -> Calendar: ...
    def resolve_utc_offset(
        self, tzid: str, dt: datetime.datetime
    ) -> Optional[datetime.timedelta]: ...
    def to_ical(self) -> bytes: ...
    @property
    def name(self) -> Optional[str]: ...
    @property
    def prodid(self) -> Optional[str]: ...
    @property
    def default_timezone(self) -> Optional[str]: ...
    @property
    def component_count(self) -> int: ...
    @property
    def warnings(self) -> List[Tuple[int, str]]: ...
    @property
    def events(self) -> List[Component]: ...
    @property
    def todos(self) -> List[Component]: ...
    @property
    def journals(self) -> List[Component]: ...
    @property
    def timezones(self) -> List[Component]: ...
    @property
    def subcomponents(self) -> List[Component]: ...
    def component_stats(self) -> Dict[str, int]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
